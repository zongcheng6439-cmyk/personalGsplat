# personalGsplat: ignore generated training data, caches and build products.
# Source code, documentation and bundled test assets remain trackable.

# Python caches and local environments
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.venv/
venv/
.cache/
.ipynb_checkpoints/

# Python / C++ / CUDA build products (kept locally, excluded from Git)
build/
dist/
*.egg-info/
*.egg
*.whl
*.so
*.dylib
*.dll
*.pyd
*.o
*.obj
*.a
*.lib
*.cubin
*.ptx
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
build.ninja
.ninja_deps
.ninja_log
compile_commands.json

# Training outputs and diagnostics
outputs/
results/
output/
result/
checkpoints/
ckpts/
runs/
wandb/
tensorboard/
ablation_voxel_plane_*/
plane_gs_after_refine/
pgsr_vis/
events.out.tfevents.*
*.log
*.log.*
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx

# Scene data, exported models, weight maps and videos
/data/
/datasets/
*.ply
*.pcd
*.las
*.laz
*.splat
*.ksplat
*.spz
*.npy
*.npz
*.mp4
*.avi
*.mov
*.mkv
ncc_source_views.json

# Preserve bundled assets and test fixtures; do not ignore source images globally.
!assets/**/*.npz
!assets/**/*.npy
!assets/**/*.ply
!tests/**/*.npz
!tests/**/*.npy
!tests/**/*.ply

# Editor / OS temporary files and machine-local secrets
.DS_Store
._*
Thumbs.db
*.swp
*.swo
*~
.env
.env.*
!.env.example
